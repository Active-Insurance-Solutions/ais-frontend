# Sanity CMS — drives all page content + site settings + nav.
VITE_SANITY_PROJECT_ID=
VITE_SANITY_DATASET=
VITE_SANITY_API_VERSION=2024-01-01

# Public site URL — used by useSeo for canonical URLs and og:image.
VITE_SITE_URL=https://activeinsurancegj.com

# Simple Analytics — usually not needed; the script is included via CDN
# in index.html and tracks automatically. Keep for parity with templates.
VITE_SIMPLE_ANALYTICS_ID=

# Sentry — client-side error monitoring. Get this DSN from sentry.io after
# creating a project (Settings → Projects → [project] → Client Keys). Sentry
# init is skipped entirely if this is empty, so leaving it blank for local
# dev is fine.
VITE_SENTRY_DSN=
